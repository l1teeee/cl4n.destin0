# Runtime environment. Use local here; set preview or production only in deployed environments.
APP_ENV=local

# Application database. Production must use its remote pooled URL and unique credentials.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/cl4n_dev

# Test database. Keep it local and isolated; the test harness rejects non-local hosts.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/cl4n_test

# Database TLS mode. Production forbids disable and should use verify-ca when possible.
DATABASE_SSL_MODE=disable

# PEM CA certificate. Leave blank locally; required whenever DATABASE_SSL_MODE is verify-ca.
DATABASE_CA_CERT=

# Connections per process pool. Local uses 10; planned production value is 5 with PgBouncer.
DATABASE_POOL_MAX=10

# LOCAL ONLY HMAC secret. Production rejects local-only values and requires at least 32 characters.
APP_SECRET=local-only-secret-change-before-deploy-1234567890

# Bearer secret for /api/cron/email-outbox. Optional locally; preview and production require 32+ characters.
CRON_SECRET=

# Email delivery mode. log is local/test only; preview and production require brevo.
EMAIL_MODE=log

# Brevo transactional API key. Leave blank in log mode.
BREVO_API_KEY=

# Brevo-verified sender address. Leave blank in log mode.
EMAIL_FROM_ADDRESS=

# Display name used for transactional email.
EMAIL_FROM_NAME=Clandestino

# Public application URL used in email links. Preview and production require https.
APP_BASE_URL=http://localhost:3000

# Bot protection mode. disabled is allowed only in local or test; production uses turnstile.
BOT_PROTECTION_MODE=turnstile

# Official always-pass Turnstile test secret. Preview and production require a real secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Official always-pass Turnstile test site key. Preview and production require a real site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Accepted Turnstile hostnames. Preview and production reject localhost entries.
TURNSTILE_ALLOWED_HOSTNAMES=localhost

# PostgreSQL rate limits. disabled is allowed only in local or test; production uses enforce.
RATE_LIMIT_MODE=enforce

# Server Sentry DSN. Blank disables reporting; use the production project DSN when enabled.
SENTRY_DSN=

# Browser Sentry DSN. Blank disables reporting; use the public production DSN when enabled.
NEXT_PUBLIC_SENTRY_DSN=
