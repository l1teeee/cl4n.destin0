# Runtime environment: local, test, preview, or production.
APP_ENV=local

# Local application database URL. Never use production credentials here.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/cl4n_dev

# Local integration-test database URL. The test harness rejects non-local hosts.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/cl4n_test

# Database TLS mode: disable, require-no-verify, or verify-ca.
DATABASE_SSL_MODE=disable

# PEM-encoded CA certificate. Required only when DATABASE_SSL_MODE=verify-ca.
DATABASE_CA_CERT=

# Maximum connections in this process pool.
DATABASE_POOL_MAX=10

# LOCAL ONLY placeholder. Replace with a random secret of at least 32 characters elsewhere.
APP_SECRET=local-only-secret-change-before-deploy-1234567890

# Bot protection mode: turnstile or disabled. Disabled is local/test only.
BOT_PROTECTION_MODE=turnstile

# Cloudflare Turnstile official always-pass test secret key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cloudflare Turnstile official always-pass test site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Comma-separated hostnames accepted from Turnstile verification.
TURNSTILE_ALLOWED_HOSTNAMES=localhost

# Rate-limit mode: enforce or disabled. Disabled is local/test only.
RATE_LIMIT_MODE=enforce

# Optional server-side Sentry DSN. Blank disables Sentry.
SENTRY_DSN=

# Optional browser-side Sentry DSN. Blank disables Sentry.
NEXT_PUBLIC_SENTRY_DSN=
