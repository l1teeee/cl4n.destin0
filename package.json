{
  "name": "clandestino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.test.local node_modules/vitest/vitest.mjs run",
    "test:agent": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.test.local --import=./scripts/agent-sandbox/vite-net-use-shim.mjs node_modules/vitest/vitest.mjs run",
    "test:concurrency": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.test.local node_modules/vitest/vitest.mjs run --config vitest.concurrency.config.ts",
    "test:concurrency:agent": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.test.local --import=./scripts/agent-sandbox/vite-net-use-shim.mjs node_modules/vitest/vitest.mjs run --config vitest.concurrency.config.ts",
    "load-test:server": "node --env-file-if-exists=.env.local scripts/start-load-test-server.mjs",
    "test:load": "node --env-file-if-exists=.env.local scripts/load-test.ts",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "db:start": "node --env-file-if-exists=.env.local scripts/local-db.mjs start",
    "db:stop": "node --env-file-if-exists=.env.local scripts/local-db.mjs stop",
    "db:status": "node --env-file-if-exists=.env.local scripts/local-db.mjs status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:concurrency && npm run build"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "5.9.1",
    "@marsidev/react-turnstile": "1.6.1",
    "@sentry/nextjs": "11.4.0",
    "@vercel/functions": "3.9.11",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "libphonenumber-js": "1.13.14",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
